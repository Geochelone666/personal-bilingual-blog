---
import PostView from "../../../components/PostView.astro";
import { getCollection } from "astro:content";
export async function getStaticPaths() {
  const posts = await getCollection("posts", (p) => p.data.lang === "en");
  return posts.map((post) => ({ params: { slug: post.data.postSlug }, props: { post } }));
}
---
<PostView lang="en" post={Astro.props.post} />
