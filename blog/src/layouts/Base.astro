---
import { SITE, IS_PRODUCTION, SITE_URL, HIT_URL } from "../site.config";
interface Props {
  lang: "zh" | "en"; title?: string; versionHash?: string; alternate?: string;
  description?: string; path?: string; article?: { published: Date; modified?: Date }; image?: string;
}
const { lang, title, versionHash, alternate, description, path, article, image } = Astro.props;
const ogImage = `${SITE_URL}${image ?? `/og/${lang}/default.png`}`;
const fullTitle = title ? `${title} · ${SITE.name[lang]}` : SITE.name[lang];
const other = lang === "zh" ? "en" : "zh";
const desc = description || SITE.description[lang];
const selfPath = path ?? Astro.url.pathname;
const canonical = `${SITE_URL}${selfPath}`;
const altAbs = alternate ? `${SITE_URL}${alternate}` : undefined;
const zhUrl = lang === "zh" ? canonical : altAbs;
const enUrl = lang === "en" ? canonical : altAbs;
const ld = article
  ? { "@context": "https://schema.org", "@type": "BlogPosting", headline: title, description: desc, inLanguage: lang === "zh" ? "zh-CN" : "en",
      datePublished: article.published.toISOString(), dateModified: (article.modified ?? article.published).toISOString(),
      author: { "@type": "Person", name: SITE.author[lang] }, mainEntityOfPage: canonical, image: ogImage }
  : { "@context": "https://schema.org", "@type": "Blog", name: SITE.name[lang], url: canonical, inLanguage: lang === "zh" ? "zh-CN" : "en" };
const t = lang === "zh" ? { search: "搜索", lang: "English" } : { search: "Search", lang: "中文" };
---
<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {!IS_PRODUCTION && <meta name="robots" content="noindex,nofollow" />}
    {versionHash && <meta name="pbb-version" content={versionHash} />}
    <link rel="canonical" href={canonical} />
    {zhUrl && <link rel="alternate" hreflang="zh-CN" href={zhUrl} />}
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {zhUrl && <link rel="alternate" hreflang="x-default" href={zhUrl} />}
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name[lang]} RSS`} href={`${SITE_URL}/${lang}/rss.xml`} />
    <meta property="og:site_name" content={SITE.name[lang]} />
    <meta property="og:title" content={title ?? SITE.name[lang]} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:locale" content={lang === "zh" ? "zh_CN" : "en_US"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={title ?? SITE.name[lang]} />
    <meta name="twitter:description" content={desc} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <style is:global>
      body { font: 17px/1.8 system-ui, -apple-system, "PingFang SC", "Noto Sans SC", sans-serif; max-width: 720px; margin: 0 auto; padding: 24px 16px; color: #1f2328; }
      a { color: #0b57d0; } header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 32px; }
      header a.home { font-weight: 700; color: inherit; text-decoration: none; } .meta { color: #6b7280; font-size: 14px; }
      nav a { margin-left: 14px; } footer { margin-top: 48px; color: #6b7280; font-size: 14px; }
      pre { overflow-x: auto; background: #f6f8fa; padding: 12px; border-radius: 6px; } img { max-width: 100%; }
      ul.posts { list-style: none; padding: 0; } ul.posts li { margin: 14px 0; }
    </style>
  </head>
  <body>
    <header>
      <a class="home" href={`/${lang}/`}>{SITE.mark}</a>
      <nav><a href={`/${lang}/search/`}>{t.search}</a><a href={`/${lang}/rss.xml`}>RSS</a><a href={alternate ?? `/${other}/`}>{t.lang}</a></nav>
    </header>
    <main><slot /></main>
    <footer>© {SITE.author[lang]}</footer>
    {IS_PRODUCTION && <script is:inline define:vars={{ hit: HIT_URL }}>
      try {
        var k = "pbb:" + location.pathname;
        if (!sessionStorage.getItem(k)) {
          sessionStorage.setItem(k, "1");
          navigator.sendBeacon(hit + "?p=" + encodeURIComponent(location.pathname) + "&r=" + encodeURIComponent(document.referrer ? new URL(document.referrer).host : ""));
        }
      } catch (e) {}
    </script>}
  </body>
</html>
