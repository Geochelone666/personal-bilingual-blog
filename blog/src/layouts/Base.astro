---
import { SITE, IS_PRODUCTION } from "../site.config";
interface Props { lang: "zh" | "en"; title?: string; versionHash?: string; alternate?: string; }
const { lang, title, versionHash, alternate } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name[lang]}` : SITE.name[lang];
const other = lang === "zh" ? "en" : "zh";
---
<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={SITE.description[lang]} />
    {!IS_PRODUCTION && <meta name="robots" content="noindex,nofollow" />}
    {versionHash && <meta name="pbb-version" content={versionHash} />}
    {alternate && <link rel="alternate" hreflang={other} href={alternate} />}
    <style is:global>
      body { font: 17px/1.8 system-ui, -apple-system, "PingFang SC", "Noto Sans SC", sans-serif; max-width: 720px; margin: 0 auto; padding: 24px 16px; color: #1f2328; }
      a { color: #0b57d0; } header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 32px; }
      header a.home { font-weight: 700; color: inherit; text-decoration: none; } .meta { color: #6b7280; font-size: 14px; }
      pre { overflow-x: auto; background: #f6f8fa; padding: 12px; border-radius: 6px; } img { max-width: 100%; }
      ul.posts { list-style: none; padding: 0; } ul.posts li { margin: 14px 0; }
    </style>
  </head>
  <body>
    <header>
      <a class="home" href={`/${lang}/`}>{SITE.name[lang]}</a>
      <nav><a href={alternate ?? `/${other}/`}>{lang === "zh" ? "English" : "中文"}</a></nav>
    </header>
    <main><slot /></main>
  </body>
</html>
