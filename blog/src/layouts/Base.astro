---
import { SITE, IS_PRODUCTION, SITE_URL, HIT_URL, UI } from "../site.config";
import "../styles/global.css";
interface Props {
  lang: "zh" | "en"; title?: string; versionHash?: string; alternate?: string;
  description?: string; path?: string; article?: { published: Date; modified?: Date }; image?: string;
}
const { lang, title, versionHash, alternate, description, path, article, image } = Astro.props;
const ogImage = `${SITE_URL}${image ?? `/og/${lang}/default.png`}`;
const fullTitle = title ? `${title} · ${SITE.name[lang]}` : SITE.name[lang];
const other = lang === "zh" ? "en" : "zh";
const desc = description || SITE.description[lang];
const selfPath = path ?? Astro.url.pathname;
const canonical = `${SITE_URL}${selfPath}`;
const altAbs = alternate ? `${SITE_URL}${alternate}` : undefined;
const zhUrl = lang === "zh" ? canonical : altAbs;
const enUrl = lang === "en" ? canonical : altAbs;
const ld = article
  ? { "@context": "https://schema.org", "@type": "BlogPosting", headline: title, description: desc, inLanguage: lang === "zh" ? "zh-CN" : "en",
      datePublished: article.published.toISOString(), dateModified: (article.modified ?? article.published).toISOString(),
      author: { "@type": "Person", name: SITE.author[lang] }, mainEntityOfPage: canonical, image: ogImage }
  : { "@context": "https://schema.org", "@type": "Blog", name: SITE.name[lang], url: canonical, inLanguage: lang === "zh" ? "zh-CN" : "en" };
const t = UI[lang];
---
<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {!IS_PRODUCTION && <meta name="robots" content="noindex,nofollow" />}
    {versionHash && <meta name="pbb-version" content={versionHash} />}
    <link rel="canonical" href={canonical} />
    {zhUrl && <link rel="alternate" hreflang="zh-CN" href={zhUrl} />}
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {zhUrl && <link rel="alternate" hreflang="x-default" href={zhUrl} />}
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name[lang]} RSS`} href={`${SITE_URL}/${lang}/rss.xml`} />
    <meta property="og:site_name" content={SITE.name[lang]} />
    <meta property="og:title" content={title ?? SITE.name[lang]} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:locale" content={lang === "zh" ? "zh_CN" : "en_US"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={title ?? SITE.name[lang]} />
    <meta name="twitter:description" content={desc} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#faf8f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16161a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href={new URL(HIT_URL).origin} crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">{lang === "zh" ? "跳到正文" : "Skip to content"}</a>
    <header class="site">
      <a class="brand" href={`/${lang}/`}><span class="seal" aria-hidden="true">砚</span><span>{SITE.mark}</span></a>
      <nav aria-label={lang === "zh" ? "站点导航" : "Site"}>
        <a href={`/${lang}/search/`} aria-label={t.search}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><span class="nl">{t.search}</span></a>
        <a href={`/${lang}/rss.xml`}>RSS</a>
        <a class="lang" href={alternate ?? `/${other}/`} hreflang={other === "zh" ? "zh-CN" : "en"} lang={other === "zh" ? "zh-CN" : "en"}>{t.other}</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site"><span>© {new Date().getFullYear()} {SITE.author[lang]}</span><span>{SITE.description[lang]}</span></footer>
    {IS_PRODUCTION && <script is:inline define:vars={{ hit: HIT_URL }}>
      try {
        var k = "pbb:" + location.pathname;
        if (!sessionStorage.getItem(k)) {
          sessionStorage.setItem(k, "1");
          navigator.sendBeacon(hit + "?p=" + encodeURIComponent(location.pathname) + "&r=" + encodeURIComponent(document.referrer ? new URL(document.referrer).host : ""));
        }
      } catch (e) {}
    </script>}
  </body>
</html>
